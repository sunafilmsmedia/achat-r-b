# ─── Roux et Bachand — ACHETEUR (achat-r-b) ─────────────────────────────
# Copier vers .env.local et remplir au déploiement.

# Optionnel — sans clé, l'app utilise le rapport déterministe de fallback
# (les montants, eux, sont TOUJOURS calculés par lib/capacity.ts).
ANTHROPIC_API_KEY=

# Webhook CRM (GHL) — sans URL, les leads sont seulement logés côté serveur
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── À câbler dans le code au déploiement ───────────────────────────────
# Vidéo « plus de 12 mois » → lib/config.ts        (VIDEO_LONG_TERME_URL)
# Meta Pixel ID             → components/MetaPixel.tsx  (const PIXEL_ID)
# Clarity Project ID        → components/Clarity.tsx    (CLARITY_PROJECT_ID)
# Les trois sont vides par défaut : aucun script n'est injecté et l'écran
# vidéo s'affiche sans bouton tant qu'ils ne sont pas renseignés.
